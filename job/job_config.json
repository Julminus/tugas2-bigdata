{
  "name": "tugas2_taxi_lakehouse_job",
  "description": "Tugas 2: pull dataset from Google Drive -> feed new CSV -> DLT (bronze -> silver -> gold) -> call model serving API. Runs every 2 minutes.",
  "email_notifications": {},
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "0 0/2 * * * ?",
    "timezone_id": "Asia/Jakarta",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "pull_from_gdrive",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Users/databricks-user@example.com/tugas2/00b_pull_from_gdrive",
        "base_parameters": {
          "gdrive_file_id": "{{job.parameters.gdrive_file_id}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "feed_new_csv",
      "depends_on": [
        {
          "task_key": "pull_from_gdrive"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Users/databricks-user@example.com/tugas2/00_feed_new_csv",
        "base_parameters": {
          "landing_path": "{{job.parameters.landing_path}}",
          "days": "1",
          "source_table": "{{job.parameters.source_table}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "dlt_bronze_silver_gold",
      "depends_on": [
        {
          "task_key": "feed_new_csv"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "pipeline_task": {
        "pipeline_id": "49a872dc-89ab-4298-bb68-d5b6146e37ad",
        "full_refresh": false
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "call_model_api",
      "depends_on": [
        {
          "task_key": "dlt_bronze_silver_gold"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Users/databricks-user@example.com/tugas2/03_call_model_api",
        "base_parameters": {
          "endpoint_name": "{{job.parameters.endpoint_name}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    }
  ],
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "landing_path",
      "default": "/Volumes/workspace/tugas2/raw/landing"
    },
    {
      "name": "endpoint_name",
      "default": "taxi-fare-endpoint"
    },
    {
      "name": "source_table",
      "default": "workspace.tugas2.gdrive_taxi_trips"
    },
    {
      "name": "gdrive_file_id",
      "default": "1qdFdNSagZw27kni-QjAXtlHG0ZrtgDsx"
    }
  ]
}
