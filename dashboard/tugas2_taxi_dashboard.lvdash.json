{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Overall KPIs",
      "query": "SELECT SUM(trips) AS trips, ROUND(SUM(revenue), 2) AS revenue,\n  ROUND(SUM(revenue) / SUM(trips), 2) AS avg_fare, COUNT(*) AS days_loaded,\n  date_format(MAX(last_ingested_at), 'yyyy-MM-dd HH:mm:ss') AS last_refresh\nFROM workspace.tugas2.v_taxi_daily_kpi"
    },
    {
      "name": "ds_daily",
      "displayName": "Daily trend (view)",
      "query": "SELECT * FROM workspace.tugas2.v_taxi_daily_kpi"
    },
    {
      "name": "ds_hourly",
      "displayName": "Trips by pickup hour",
      "query": "SELECT pickup_hour, SUM(trips) AS trips, ROUND(SUM(total_fare) / SUM(trips), 2) AS avg_fare\nFROM workspace.tugas2.gold_taxi GROUP BY pickup_hour"
    },
    {
      "name": "ds_dow",
      "displayName": "Fare per mile by weekday",
      "query": "SELECT pickup_dow, element_at(array('1-Sun','2-Mon','3-Tue','4-Wed','5-Thu','6-Fri','7-Sat'), pickup_dow) AS weekday,\n  SUM(trips) AS trips, ROUND(SUM(total_fare) / SUM(trips * avg_distance_mi), 2) AS fare_per_mile\nFROM workspace.tugas2.gold_taxi GROUP BY pickup_dow"
    },
    {
      "name": "ds_pred",
      "displayName": "Model API predictions",
      "query": "SELECT scored_at, pickup_ts, trip_distance, trip_duration_min, fare_amount AS actual_fare,\n  ROUND(predicted_fare, 2) AS predicted_fare, ROUND(ABS(predicted_fare - fare_amount), 2) AS abs_error\nFROM workspace.tugas2.taxi_predictions ORDER BY scored_at DESC, pickup_ts DESC LIMIT 50"
    }
  ],
